// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ─── Enums ───────────────────────────────────────────────

enum UserStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}

enum TableStatus {
  AVAILABLE
  OCCUPIED
  RESERVED
}

enum OrderStatus {
  PENDING
  PREPARING
  READY
  SERVED
  DELIVERED
  PAID
  CANCELLED
}

enum PaymentMethod {
  CASH
  MPESA
  CARD
  OTHER
}

enum PaymentStatus {
  PENDING
  COMPLETED
  FAILED
  REFUNDED
}

enum RoomStatus {
  AVAILABLE
  OCCUPIED
  MAINTENANCE
  CLEANING
  RESERVED
}

enum BookingStatus {
  CONFIRMED
  CHECKED_IN
  CHECKED_OUT
  CANCELLED
}

// ─── Models ──────────────────────────────────────────────

model User {
  id           String        @id @default(uuid())
  name         String
  username     String        @unique
  password     String
  role         Role          @relation(fields: [roleId], references: [id])
  roleId       String
  status       UserStatus    @default(ACTIVE)
  lastLogin    DateTime?
  shifts       Shift[]
  messagesSent Message[]     @relation("SentMessages")
  messagesRecv Message[]     @relation("ReceivedMessages")
  activities   ActivityLog[]
  orders       Order[]
  bookings     Booking[]
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
}

model Role {
  id          String   @id @default(uuid())
  name        String   @unique // OWNER, MANAGER, WAITER, KITCHEN, RECEPTIONIST
  permissions Json?
  users       User[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model MenuItem {
  id            String       @id @default(uuid())
  name          String       @unique
  description   String?
  price         Float
  category      Category?    @relation(fields: [categoryId], references: [id])
  categoryId    String?
  subCategory   SubCategory? @relation(fields: [subCategoryId], references: [id])
  subCategoryId String?
  isAvailable   Boolean      @default(true)
  image         String?
  orderItems    OrderItem[]
  modifiers     Modifier[]
  inventory     Inventory?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
}

model Inventory {
  id         String   @id @default(uuid())
  menuItem   MenuItem @relation(fields: [menuItemId], references: [id], onDelete: Cascade)
  menuItemId String   @unique
  stock      Float    @default(0)
  allocated  Float    @default(0)
  minStock   Float    @default(5)
  unit       String   @default("pcs")
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model Category {
  id            String        @id @default(uuid())
  name          String
  image         String?
  menu          Menu?         @relation(fields: [menuId], references: [id])
  menuId        String?
  subCategories SubCategory[]
  items         MenuItem[]
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  @@unique([name, menuId])
}

model Menu {
  id          String     @id @default(uuid())
  name        String     @unique
  description String?
  categories  Category[]
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
}

model SubCategory {
  id         String     @id @default(uuid())
  name       String
  image      String?
  category   Category   @relation(fields: [categoryId], references: [id])
  categoryId String
  items      MenuItem[]
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt

  @@unique([name, categoryId])
}

model Modifier {
  id         String   @id @default(uuid())
  name       String
  price      Float    @default(0)
  menuItem   MenuItem @relation(fields: [menuItemId], references: [id])
  menuItemId String
}

model Table {
  id        String      @id @default(uuid())
  number    String      @unique
  capacity  Int
  status    TableStatus @default(AVAILABLE)
  orders    Order[]
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt
}

model Order {
  id          String      @id @default(uuid())
  waiter      User        @relation(fields: [waiterId], references: [id])
  waiterId    String
  table       Table       @relation(fields: [tableId], references: [id])
  tableId     String
  status      OrderStatus @default(PENDING)
  totalAmount Float
  items       OrderItem[]
  payments    Payment[]
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
}

model OrderItem {
  id                String             @id @default(uuid())
  order             Order              @relation(fields: [orderId], references: [id])
  orderId           String
  menuItem          MenuItem           @relation(fields: [menuItemId], references: [id])
  menuItemId        String
  quantity          Int
  price             Float
  selectedModifiers SelectedModifier[]
}

model SelectedModifier {
  id          String    @id @default(uuid())
  orderItem   OrderItem @relation(fields: [orderItemId], references: [id])
  orderItemId String
  name        String
  price       Float
}

model Payment {
  id        String        @id @default(uuid())
  order     Order?        @relation(fields: [orderId], references: [id])
  orderId   String?
  booking   Booking?      @relation(fields: [bookingId], references: [id])
  bookingId String?
  amount    Float
  method    PaymentMethod
  reference String?
  status    PaymentStatus @default(PENDING)
  details   Json?
  createdAt DateTime      @default(now())
}

model Room {
  id        String     @id @default(uuid())
  number    String     @unique
  type      String
  price     Float
  amenities Json?
  status    RoomStatus @default(AVAILABLE)
  bookings  Booking[]
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
}

model Booking {
  id           String        @id @default(uuid())
  guestName    String
  guestPhone   String?
  room         Room          @relation(fields: [roomId], references: [id])
  roomId       String
  receptionist User          @relation(fields: [userId], references: [id])
  userId       String
  checkIn      DateTime
  checkOut     DateTime
  status       BookingStatus @default(CONFIRMED)
  totalAmount  Float
  notes        String?
  payments     Payment[]
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
}

model Shift {
  id        String    @id @default(uuid())
  user      User      @relation(fields: [userId], references: [id])
  userId    String
  date      DateTime
  role      String
  startTime DateTime?
  endTime   DateTime?
  createdAt DateTime  @default(now())
}

model Message {
  id          String   @id @default(uuid())
  content     String
  sender      User     @relation("SentMessages", fields: [senderId], references: [id])
  senderId    String
  isBroadcast Boolean  @default(false)
  recipient   User?    @relation("ReceivedMessages", fields: [recipientId], references: [id])
  recipientId String?
  createdAt   DateTime @default(now())
}

model ActivityLog {
  id        String   @id @default(uuid())
  user      User     @relation(fields: [userId], references: [id])
  userId    String
  action    String
  details   Json?
  timestamp DateTime @default(now())
}
